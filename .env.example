# Copy to .env.local and fill in to run the full stack locally (npm run dev).
# On Vercel this is injected automatically by the Neon integration — you do NOT
# need to set it there.
#
# Get this from: Neon dashboard → Connection string (pooled), or
# Vercel → Storage → your Neon database → .env.local tab.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
